{
  "name": "ptb-battle-server",
  "version": "0.0.0",
  "private": true,
  "description": "PokeTokenBar Battle league server (Cloudflare Worker + League Durable Object). Not deployed from this package.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "measure:battles": "vitest run --project ws test/ws/battle-cost.test.ts --reporter=verbose",
    "measure:packed-load": "vitest run --config vitest.measure.config.ts measure/packed-load.test.ts --reporter=verbose",
    "measure:retention": "vitest run --config vitest.measure.config.ts measure/retention.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261023.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.153.0"
  }
}
