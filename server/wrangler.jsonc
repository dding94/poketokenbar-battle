// Local and test configuration, plus the PR 05 measurement environment `env.dev`.
// Deploys happen only with the user; see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ptb-battle-league",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "LEAGUE", "class_name": "League" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["League"] }],
  // Workers Logs stay off until PR 05 checks what would actually be recorded.
  "observability": { "enabled": false, "logs": { "enabled": false } },
  "env": {
    // Measurement environment (Appendix C): its own Worker, so its League storage is separate.
    "dev": {
      "name": "ptb-battle-league-dev",
      "workers_dev": true,
      // Bindings are not inherited by environments.
      "durable_objects": {
        "bindings": [{ "name": "LEAGUE", "class_name": "League" }]
      },
      "observability": { "enabled": false, "logs": { "enabled": false } }
    }
  }
  // Secrets OPERATOR_SECRET and CODE_PEPPER are never written here.
}
