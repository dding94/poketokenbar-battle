# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# App bundle build output
build/

# OMC / agent local state
.omc/

# macOS
.DS_Store
*.xcuserstate

# Signing material — never commit private keys / certs
*.p12
*.pem
*.key
*.cer
*.certSigningRequest

# Personal dev notes (kept locally, not published).
# docs/reference/ is the exception: published agent/contributor reference docs.
# (Must ignore docs/* rather than docs/ — git cannot re-include inside an excluded directory.)
docs/*
!docs/reference/

# Agent worktrees / local state
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/prepare-pr
.worktrees/

# Local-only review-gate opt-out (not published)
.no-review-gate

# Versioned battle project instructions
!docs/BATTLE_PLAN.md
!docs/AI_HANDOFF.md

# Future battle server dependencies, output, and local Cloudflare state
node_modules/
server/dist/
.wrangler/
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example
coverage/

# Stray coverage output from running a test binary directly
*.profraw
